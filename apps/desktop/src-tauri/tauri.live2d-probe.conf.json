{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Desktop Pet Live2D Probe",
  "version": "0.0.0",
  "identifier": "com.desktop-pet.live2d-probe",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 1421",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "pet",
      "title": "Desktop Pet Live2D Probe",
      "width": 420,
      "height": 520,
      "transparent": true,
      "decorations": false,
      "shadow": false,
      "alwaysOnTop": true,
      "skipTaskbar": true,
      "focus": false,
      "resizable": true,
      "url": "index.html?live2dProbe=1",
      "additionalBrowserArgs": ""
    }],
    "security": { "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; img-src 'self' pet-asset: asset: blob: data:; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": { "active": false }
}
