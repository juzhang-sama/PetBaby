{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Desktop Pet M0",
  "version": "0.0.0",
  "identifier": "com.desktop-pet.probe",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "pet",
        "title": "Desktop Pet M0",
        "width": 420,
        "height": 520,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "resizable": true
      },
      {
        "label": "settings",
        "title": "桌面宠物设置",
        "url": "settings.html",
        "width": 720,
        "height": 520,
        "visible": false,
        "resizable": true
      }
    ],
    "security": { "csp": "default-src 'self'; img-src 'self' asset: blob: data:; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": { "active": false }
}
