# Copy to .env and fill in your key. NEVER commit .env.
LK888_API_KEY=
LK888_BASE_URL=https://api.lk888.ai
LK888_MODEL=gpt-image-2
# Optional vision model (OpenAI-compatible chat completions) used to build the
# pet identity profile from uploaded photos. Empty = auto-analysis disabled.
# Example: gpt-4o
LK888_ANALYZE_MODEL=
SAAS_DATA_DIR=./data
POLL_INTERVAL=2.0
MAX_JOB_WAIT_SECONDS=300.0
SAAS_ACCESS_TOKEN=
RATE_LIMIT_PER_MINUTE=10
HOST=127.0.0.1
PORT=8787
